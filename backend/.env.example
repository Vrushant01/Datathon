# ─────────────────────────────────────────────────────────────────────────────
# KSP Datathon Backend – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=5000

# AI Assistant / Chat Tuning
CHAT_HISTORY_LIMIT=10
MAX_CONTEXT_DOCUMENTS=8
ENABLE_STREAMING=true
ENABLE_QUERY_CACHE=true
CACHE_TTL=300
MAX_REQUESTS_PER_MINUTE=60

# Database Provider ("cloudscale" for production Zoho Catalyst DataStore)
DB_PROVIDER=cloudscale

# Zoho Catalyst QuickML – Station Risk Prediction (XGBoost endpoint)
QUICKML_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/<YOUR_PROJECT_ID>/endpoints/predict
QUICKML_ACCESS_TOKEN=<YOUR_QUICKML_ACCESS_TOKEN>
QUICKML_REFRESH_TOKEN=<YOUR_QUICKML_REFRESH_TOKEN>
QUICKML_ORG_ID=<YOUR_QUICKML_ORG_ID>
QUICKML_ENDPOINT_KEY=<YOUR_QUICKML_ENDPOINT_KEY>

# Zoho Catalyst GLM – AI Assistant (GLM-4.7-Flash)
QUICKML_LLM_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/<YOUR_PROJECT_ID>/glm/chat

# Zoho OAuth – Token refresh for QuickML API calls
ZOHO_REFRESH_TOKEN=<YOUR_ZOHO_REFRESH_TOKEN>
ZOHO_CLIENT_ID=<YOUR_ZOHO_CLIENT_ID>
ZOHO_CLIENT_SECRET=<YOUR_ZOHO_CLIENT_SECRET>
